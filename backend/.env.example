# Optional local settings. No MinIO credentials or cloud storage required.
DATABASE_PATH=data/pipeline.db
STORAGE_PATH=data/objects
MAX_UPLOAD_MB=10
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=5
POLL_INTERVAL_SECONDS=1
VISIBILITY_TIMEOUT_SECONDS=300
# Set to 3 to make job state changes easier to demonstrate; set to 0 normally.
WORKER_ARTIFICIAL_DELAY_SECONDS=3
